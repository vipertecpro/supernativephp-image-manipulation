{
    "name": "nativephp/plugin-image-cropper",
    "description": "A fully native, hand-written freehand image cropper for NativePHP Mobile.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Your Name",
            "email": "you@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Nativephp\\ImageCropper\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nativephp\\ImageCropper\\ImageCropperServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}